# LF everywhere: the deploy target, Docker images, CI runners and
# cloud-init/Caddy/Tofu consumers are all Linux, and git stores blobs as
# LF regardless. Editors on Windows handle LF without friction.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
