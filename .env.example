# Copy to .env and fill in real values locally. Never commit .env.
# In production this file is produced by `sops -d .env.enc` on vm-app
# (see .github/workflows/ci-cd.yml) and injected via compose env_file.

# --- process ---
NODE_ENV=development
APP_ROLE=api                     # api | worker-media | worker-general (apps/api/src/main.ts)
PORT=3000

# --- stateful services (defaults match docker-compose.dev.yml) ---
DATABASE_URL=postgres://noizera:noizera@localhost:5432/noizera
RABBITMQ_URL=amqp://guest:guest@localhost:5672
VALKEY_URL=redis://localhost:6379

# --- object storage (Hetzner S3-compatible in prod; docs/tickets/008 for local) ---
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- web (BFF) → api ---
# Server-side only; the browser never talks to the API directly (tech proposal §10).
API_INTERNAL_URL=http://localhost:3000

# --- secrets the domain model depends on (tech proposal §3.1, §4, §14) ---
# Generate with: openssl rand -base64 32
JWT_SECRET=                      # 15-minute access tokens
REFRESH_TOKEN_PEPPER=            # refresh tokens are hashed at rest
INVITATION_TOKEN_KEY=            # HMAC over invitation ids (§7)
EMAIL_HASH_PEPPER=               # listeners.email_hash (§4)
EMAIL_ENCRYPTION_KEY=            # listeners.email_encrypted (§4)
IP_HASH_SALT=                    # rotating; never store raw IPs (§14)

# --- third parties ---
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
