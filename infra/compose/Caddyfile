{
	on_demand_tls {
		ask http://api:3000/internal/tls/allow
		interval 2m
		burst 5
	}
}

noizera.com, www.noizera.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000 {
			lb_policy least_conn
			health_uri /healthz
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy web:3000 {
		header_up X-Custom-Domain {host}
	}
}
