{
	on_demand_tls {
		ask http://api:3000/internal/tls/allow
		interval 2m
		burst 5
	}
}

noizera.com, www.noizera.com {
	# Cloudflare Full (Strict) (dns.tf cloudflare_zone_settings_override)
	# needs a cert the edge trusts — a Cloudflare Origin CA cert, not
	# ACME: root/www are orange-clouded, so an HTTP-01 challenge for
	# them hits Cloudflare's edge, never this container. Provisioned by
	# hand alongside .env.enc (docs/tickets/002-caddy-origin-cert.md);
	# the on-demand ACME block below is unaffected — edge.noizera.com is
	# deliberately unproxied.
	tls /certs/origin.pem /certs/origin.key

	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000 {
			lb_policy least_conn
			health_uri /healthz
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy web:3000 {
		header_up X-Custom-Domain {host}
	}
}
